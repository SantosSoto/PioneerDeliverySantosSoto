{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Part II",
      "type": "process",
      "command": "python3",
      "args": ["main.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Show Part II case results",
      "type": "process",
      "command": "python3",
      "args": ["main.py", "--cases"],
      "options": {"cwd": "${workspaceFolder}"},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    },
    {
      "label": "Test Part II",
      "type": "process",
      "command": "python3",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-v"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "problemMatcher": []
    }
  ]
}
